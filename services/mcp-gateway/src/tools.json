  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Edit one literal text occurrence in an explicitly edit-enabled project source. First file_read and use its sha256. On conflict, reread; never blindly retry. old_text must match exactly once. Preserves other bytes and permissions. Maximum file size 1MiB; old_text+new_text at most 32KiB. No commands or deletion. Read back and inspect git_diff afterwards.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "expected_sha256": {
          "description": "Exact full-file sha256 from the latest file_read",
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "new_text": {
          "description": "Replacement text; empty deletes only the matched text",
          "type": "string"
        },
        "old_text": {
          "description": "Unique literal text including sufficient context",
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "description": "Relative ordinary text-file path within the project source. Existing parent directories required. No symlinks, secrets, hidden or agent-instruction files.",
          "type": "string"
        },
        "project_id": {
          "description": "Published project id with file_edit_enabled=true",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "path",
        "expected_sha256",
        "old_text",
        "new_text"
      ],
      "type": "object"
    },
    "name": "file_edit"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "description": "Run a host command only in a project with command_execution_enabled=true. Supply program and literal args (no implicit shell); cwd is relative to the project root. This grants the server user's OS privileges, including file changes/deletion and network access, outside file-edit restrictions. Default timeout 30000ms, maximum 120000ms; capped/redacted stdout and stderr. Inspect exit_code, signal, timed_out and output_truncated. Do not blindly retry commands with side effects.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "cwd": {
          "description": "Relative project directory, default project root; no symlinks",
          "type": "string"
        },
        "program": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "timeout_ms": {
          "default": 30000,
          "maximum": 120000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "project_id",
        "program"
      ],
      "type": "object"
    },
    "name": "command_run"
  }
